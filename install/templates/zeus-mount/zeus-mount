#!/usr/bin/env bash
set -uo pipefail

# Atalhos e diagnóstico dos shares SMB do NAS (ZEUS).
#
#   zeus-mount            confere os links em ~/mnt/zeus e acorda cada share
#   zeus-mount status     diz qual share responde
#
# Os shares são montagens CIFS do kernel com automount, declaradas no /etc/fstab
# pelo módulo 89 (precisa de root uma vez). O systemd monta cada um no primeiro
# acesso, desmonta depois de 10 minutos parado e monta de novo no acesso
# seguinte, então não há mais nada para "montar" aqui.
#
# Até 20/11/2026 isto era feito pelo gvfs, no espaço do usuário. O gvfs largava
# a montagem sem aviso quando o QNAP derrubava a sessão ociosa: os cinco shares
# sumiam juntos (três vezes em três semanas) enquanto o /mnt/zeus-backup, já em
# CIFS de kernel, nunca caiu.

MNT_DIR="${ZEUS_MNT_DIR:-/mnt/zeus}"
LINK_DIR="${ZEUS_LINK_DIR:-$HOME/mnt/zeus}"
SHARES=(Multimedia Exato ExatoDigital Takitani Public)

say() { echo "[ezomar][zeus] $*"; }

lower() { echo "$1" | tr '[:upper:]' '[:lower:]'; }

case "${1:-mount}" in
  mount | m | "")
    mkdir -p "$LINK_DIR"
    ok=0
    for s in "${SHARES[@]}"; do
      name="$(lower "$s")"
      ln -sfn "$MNT_DIR/$name" "$LINK_DIR/$name"
      # Listar dispara o automount; o timeout cobre NAS desligado.
      if timeout 15 ls "$MNT_DIR/$name/" >/dev/null 2>&1; then
        ok=$((ok + 1))
      else
        say "não respondeu: $s" >&2
      fi
    done
    say "$ok de ${#SHARES[@]} shares em $LINK_DIR."
    [ "$ok" -eq "${#SHARES[@]}" ]
    ;;
  status | s)
    for s in "${SHARES[@]}"; do
      name="$(lower "$s")"
      if timeout 15 ls "$MNT_DIR/$name/" >/dev/null 2>&1; then
        say "ok: $s"
      else
        say "fora: $s"
      fi
    done
    ;;
  umount | unmount | u)
    say "Os shares desmontam sozinhos após 10 min parados (automount)."
    ;;
  *)
    say "Uso: zeus-mount [mount|status]" >&2
    exit 2
    ;;
esac
