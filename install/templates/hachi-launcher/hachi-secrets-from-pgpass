#!/usr/bin/env bash
set -uo pipefail

# Repovoa o cofre do hachi a partir do ~/.pgpass.
#
# O hachi guarda a senha de cada conexão no cofre do sistema, e cofre não viaja
# entre ambientes de desktop: no KDE era o kwallet, no Hyprland é o
# gnome-keyring, e um não lê o outro. Depois de migrar, as conexões aparecem na
# lista e falham com "invalid configuration", que parece config corrompida e é
# só senha ausente.
#
# O ~/.pgpass viaja no backup e já tem host, porta, base, usuário e senha. Este
# script casa as duas listas e devolve as senhas ao cofre.
#
# A senha nunca aparece em argv nem na saída: vai por stdin para
# `hachi secret set --stdin`, e o que se imprime é só o nome da conexão.

CONFIG="${HACHI_CONFIG:-$HOME/.config/hachi/config.toml}"
PGPASS="${PGPASSFILE:-$HOME/.pgpass}"
HACHI="${HACHI_BIN:-}"

say() { echo "[ezomar][hachi-secrets] $*"; }

if [ -z "$HACHI" ]; then
  HACHI="$(command -v hachi 2>/dev/null || true)"
  [ -n "$HACHI" ] || for c in "$HOME/work/repos/takitani-labs/hachi/target/release/hachi" \
                              "$HOME/work/repos/takitani-labs/hachi/target/debug/hachi"; do
    [ -x "$c" ] && { HACHI="$c"; break; }
  done
fi
[ -n "$HACHI" ] || { say "binário do hachi não encontrado; compile antes (hachi-dev)." >&2; exit 1; }
[ -f "$CONFIG" ] || { say "sem $CONFIG." >&2; exit 1; }
[ -f "$PGPASS" ] || { say "sem $PGPASS; nada de onde tirar as senhas." >&2; exit 1; }

# O casamento sai do python porque o pgpass tem curingas (* em host, porta,
# base ou usuário) e a senha pode conter ":" escapado. Fazer isso com corte de
# campo em shell erra silenciosamente e grava a senha errada, que é pior que
# não gravar nada.
mapfile -t PAIRS < <(
  CONFIG="$CONFIG" PGPASS="$PGPASS" python3 <<'PYEOF'
import os
import tomllib

cfg = tomllib.load(open(os.environ["CONFIG"], "rb"))


def split_pgpass(line):
    """host:port:db:user:password, com \\: escapando um dois-pontos literal."""
    out, cur, esc = [], "", False
    for ch in line:
        if esc:
            cur += ch
            esc = False
        elif ch == "\\":
            esc = True
        elif ch == ":":
            out.append(cur)
            cur = ""
        else:
            cur += ch
    out.append(cur)
    return out


entries = []
for raw in open(os.environ["PGPASS"], encoding="utf-8", errors="replace"):
    raw = raw.rstrip("\n")
    if not raw or raw.lstrip().startswith("#"):
        continue
    parts = split_pgpass(raw)
    if len(parts) >= 5:
        entries.append(parts[:4] + [":".join(parts[4:])])


def field_matches(pattern, value):
    return pattern == "*" or pattern == str(value)


for conn in cfg.get("connections", []):
    cid = conn.get("id") or conn.get("name")
    if not cid or conn.get("password"):
        continue          # já tem senha em claro no arquivo; o cofre nao entra
    if not conn.get("host"):
        continue          # sqlite, gcs: arquivo ou bucket, nao tem senha de rede
    host, port = str(conn.get("host", "")), str(conn.get("port", ""))
    db, user = str(conn.get("database", "")), str(conn.get("user", ""))
    for h, p, d, u, pw in entries:
        if (field_matches(h, host) and field_matches(p, port)
                and field_matches(d, db) and field_matches(u, user)):
            # Uma linha por conexao: id e senha separados por TAB, que o
            # pgpass nunca contem em campo de host/porta/base/usuario.
            print("%s\t%s" % (cid, pw))
            break
PYEOF
)

[ "${#PAIRS[@]}" -gt 0 ] || { say "nenhuma conexão casou com uma linha do pgpass."; exit 0; }

OK=0
FAIL=0
for pair in "${PAIRS[@]}"; do
  cid="${pair%%	*}"
  pw="${pair#*	}"
  if printf '%s' "$pw" | "$HACHI" secret set "$cid" --stdin >/dev/null 2>&1; then
    OK=$((OK + 1))
    say "senha gravada: $cid"
  else
    FAIL=$((FAIL + 1))
    say "falhou ao gravar: $cid" >&2
  fi
done

say "$OK conexão(ões) com senha no cofre; $FAIL falha(s)."
