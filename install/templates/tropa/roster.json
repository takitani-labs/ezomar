      "cross_required": false,
      "agent_prefix": "estego",
      "kind": "kimi",
      "auth": "$HOME/.kimi-code-profiles/personal/credentials",
      "usage": "ezomar-ai-usagebar-kimi-personal.json",
      "model": "kimi-code/k3",
      "effort": {
        "exec": "high",
        "hard": "high",
        "max": "max",
        "max_safe": "high"
      },
      "env": {
        "KIMI_CODE_HOME": "$HOME/.kimi-code-profiles/personal",
        "KIMI_CODE_NO_AUTO_UPDATE": "1",
        "KIMI_MODEL_THINKING_EFFORT": "{EFFORT}"
      },
      "tui": {
        "args": [
          "--auto",
          "-m",
          "{MODEL}"
        ]
      },
      "headless": {
        "bin": "$HOME/.kimi-code/bin/kimi",
        "args": [
          "-m",
          "{MODEL}",
          "-p",
          "{PROMPT}",
          "--output-format",
          "stream-json"
        ]
      },
      "trust": "kimi-file",
      "exit": {
        "keys": [
          "ctrl+c",
          "ctrl+c"
        ]
      }
    },
    "glm-zai": {
      "enabled": true,
      "provider": "Z.AI GLM Coding Pro via OpenCode (provider zai)",
      "account": "zai",
      "tier": "medio",
      "cross_required": false,
      "agent_prefix": "braqui",
      "kind": "opencode",
