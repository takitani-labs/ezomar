[Unit]
Description=Backup do home com borgmatic (Hetzner + ZEUS)
# Sem rede não há o que fazer: o repositório do Hetzner é remoto e o do ZEUS
# está atrás de um mount cifs.
After=network-online.target
Wants=network-online.target
# Falhar em silêncio é o pior desfecho possível aqui: o silêncio se parece com
# sucesso, noite após noite, até o dia da restauração.
OnFailure=ezomar-borgmatic-failure@%n.service

[Service]
Type=oneshot
# Backup não pode competir com o trabalho de quem está na máquina. Isto o põe
# atrás de tudo em CPU e em disco, ao custo de demorar mais, que é o certo para
# algo que roda de madrugada.
Nice=19
CPUSchedulingPolicy=batch
IOSchedulingClass=best-effort
IOSchedulingPriority=7
# O systemd de usuário não herda PATH de shell nenhum, e o borg-passphrase
# chama o `op`.
Environment=PATH=%h/.local/bin:%h/.local/share/mise/shims:/usr/local/bin:/usr/bin:/bin
ExecStart=/usr/bin/borgmatic --verbosity 1 --syslog-verbosity 1
# `SuccessExitStatus=0 1` estava aqui para um repositório fora do ar não deixar a
# unidade em failed. Era errado: 1 é justamente como o borgmatic relata QUALQUER
# erro, então tratar 1 como sucesso apagava a falha inteira, e o aviso acima
# nunca dispararia. Unidade em failed não trava nada: o timer chama de novo na
# próxima noite, e o estado vermelho é exatamente o sinal que se quer.
TimeoutStartSec=6h

[Install]
WantedBy=default.target
